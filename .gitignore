__pycache__/
*.pyc
.playwright-mcp/
*.png

# The College Board source material: 74MB of PDFs and ~1,000 question images.
# `tools/extract_material.py` rebuilds material/keys and material/items from
# the PDFs; the keys and transcripts are tracked because the gate reads them.
material/*.pdf
material/items/

# The serving layer's runtime state: a student database and the mail that had
# nowhere to go. forms.json IS tracked -- the ten diagnostics are the product.
server/*.db
server/*.db-wal
server/*.db-shm
server/outbox/
