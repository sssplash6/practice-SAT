[Unit]
Description=SAT Freshman (FastAPI + SQLite)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=freshbot
Group=freshbot
WorkingDirectory=/srv/satbank
EnvironmentFile=/etc/freshbot/satbank.env
# Migrations, new columns and today's contests run once here, so the workers below start on a ready
# database instead of racing each other through the same one-time steps.
ExecStartPre=/srv/satbank/.venv/bin/python -c "from server.app import startup; startup()"
# Loopback only: Caddy is the only process on 80/443. Four workers, one per core: a class of about
# 100 handing in at once queued for a minute on one process (load test, 2026-10-23).
ExecStart=/srv/satbank/.venv/bin/python -m uvicorn server.app:app --host 127.0.0.1 --port 3020 --workers 4 --log-level warning
TimeoutStartSec=300
Restart=always
RestartSec=5

StateDirectory=freshbot/satbank
StateDirectoryMode=0750

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
# the database lives in /var/lib/freshbot/satbank; mail drafts, report files and caches in server/
ReadWritePaths=/var/lib/freshbot/satbank /srv/satbank/server

[Install]
WantedBy=multi-user.target
