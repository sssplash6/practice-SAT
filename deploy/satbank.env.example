# Copy to /etc/freshbot/satbank.env on the VPS (chmod 600) and fill in.
PYTHONPATH=/srv/satbank
SATF_DB=/var/lib/freshbot/satbank/satfreshman.db
# The public address people open; mail links and sign-in use it.
SATF_BASE_URL=https://REPLACE-ME.example.com
# A long random string for the /admin pages: `openssl rand -hex 24`
SATF_ADMIN_TOKEN=REPLACE-ME
# Optional: without SMTP, emails are written to server/outbox instead of sent.
#SATF_SMTP_HOST=smtp.example.com
#SATF_SMTP_PORT=587
#SATF_SMTP_USER=
#SATF_SMTP_PASS=
#SATF_MAIL_FROM=SAT Freshman <no-reply@example.com>
#SATF_GOOGLE_CLIENT_ID=
