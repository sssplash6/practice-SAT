# Add to /etc/caddy/Caddyfile, with your real domain (its DNS A record must point at the VPS):
sat.example.com {
	encode zstd gzip
	# a restart rebuilds the question catalogue (~20 s): wait for the app instead of a 502
	reverse_proxy 127.0.0.1:3020 {
		lb_try_duration 30s
	}
}

# No domain yet? Serve it on the VPS's IP over plain http instead (replace the block above):
# :80 {
# 	reverse_proxy 127.0.0.1:3020
# }
